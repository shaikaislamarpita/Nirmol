{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "jobs": {
      "root": "jobs",
      "runtime": "python",
      "entrypoint": "main.py"
    },
    "web": {
      "root": "web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
